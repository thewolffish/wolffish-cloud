{
  "name": "wfc-api",
  "version": "1.0.0",
  "private": true,
  "description": "Wolffish Cloud master API — the single choke-point Worker at api.wolffi.sh: auth, sessions, model routing (DeepInfra), sync, admin.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply wfc-master --local",
    "db:migrate:remote": "wrangler d1 migrations apply wfc-master --remote"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.118.0"
  }
}
