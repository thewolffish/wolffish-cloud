{
  "name": "wfc-api",
  "version": "1.7.1",
  "private": true,
  "description": "Wolffish Cloud master API — the single choke-point Worker at api.wolffi.sh: auth, sessions, pairing + the desktop↔phone bridge, model routing (DeepInfra), web search (Brave), sync, admin.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "tsc --noEmit && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/smoke-all.mjs",
    "db:migrate:local": "wrangler d1 migrations apply wfc-master --local",
    "db:migrate:remote": "wrangler d1 migrations apply wfc-master --remote",
    "verify": "node scripts/verify-live.mjs",
    "seed:remote": "node scripts/seed-demo.mjs --remote"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.118.0"
  }
}
