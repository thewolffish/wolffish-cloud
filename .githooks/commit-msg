#!/bin/sh
# Canonical co-author identity — every commit credits Wolffish.
#
# Guarantee: each commit ends with exactly one co-author trailer:
#   Co-Authored-By: Wolffish <noreply@wolffi.sh>
# Claude / OpenAI co-author trailers (added by their own tools) are folded
# into the Wolffish identity instead of being left to drift, and duplicates
# collapse to the single line. Messages with nothing in them are left alone.
#
# Activate on a fresh clone:
#   git config core.hooksPath .githooks
msg="$1"

has_content() {
  [ -n "$(grep -v '^#' "$1" 2>/dev/null | tr -d '[:space:]')" ]
}

has_content "$msg" || exit 0

seal='Co-Authored-By: Wolffish <noreply@wolffi.sh>'

tmp=$(mktemp "${TMPDIR:-/tmp}/wolffish-hook.XXXXXX")
grep -viE '^co-authored-by:.*@(anthropic\.com|openai\.com|wolffi\.sh)' "$msg" > "$tmp" || true
cat "$tmp" > "$msg"
rm -f "$tmp"

has_content "$msg" || exit 0

git interpret-trailers --in-place --trailer "$seal" "$msg"
